# LancerSnap mobile environment template.
# Copy to `.env` (git-ignored) and adjust locally.
#
# EXPO_PUBLIC_* values are embedded in the app bundle and visible to anyone
# with the app. NEVER put secrets here.

# Base URL of the LancerSnap FastAPI backend.
# On a physical device, use your computer's LAN IP instead of localhost.
EXPO_PUBLIC_API_URL=http://localhost:8000
