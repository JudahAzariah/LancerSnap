# LancerSnap mobile environment template.
# Copy to `.env` (git-ignored) and adjust locally.
#
# EXPO_PUBLIC_* values are embedded in the app bundle and visible to anyone
# with the app. NEVER put secrets here (no secret/service-role keys, no
# database password, no AI provider keys).

# Base URL of the LancerSnap FastAPI backend.
# On a physical device, use your computer's LAN IP instead of localhost.
EXPO_PUBLIC_API_URL=http://localhost:8000

# Supabase project URL (Project Settings > Data API), e.g. https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_URL=

# Supabase *publishable* key (Project Settings > API Keys). Older projects call
# this the "anon" key. It is designed to be public.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
