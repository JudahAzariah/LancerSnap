# LancerSnap backend environment template.
# Copy to `.env` (git-ignored) and fill in real values locally.
# NEVER commit real values. Secrets stay server-side only.

ENVIRONMENT=development
CORS_ORIGINS=http://localhost:8081

# Supabase project URL (Project Settings > Data API), e.g. https://<project-ref>.supabase.co
SUPABASE_URL=

# Leave EMPTY unless your Supabase project still signs tokens with the legacy
# shared JWT secret (HS256). Projects using asymmetric signing keys are verified
# through the project's public keys and need no secret here.
SUPABASE_JWT_SECRET=

# SECRET. PostgreSQL connection string for the Supabase database; it contains
# the database password. In the Supabase dashboard click "Connect" and copy the
# "Session pooler" connection string, replacing [YOUR-PASSWORD].
# Never put this in mobile/.env and never commit it.
DATABASE_URL=

# SECRET. Supabase secret API key (Project Settings > API Keys > "Secret keys",
# starts with sb_secret_; older projects: the service_role key). The backend
# uses it only to create short-lived signed URLs for report photos.
# Never put this in mobile/.env and never commit it.
SUPABASE_SECRET_KEY=
